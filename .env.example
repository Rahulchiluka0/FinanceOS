PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/financeos?schema=public"
# Required by Prisma (use same value as DATABASE_URL for local Postgres)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/financeos?schema=public"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Jobs: inline (cron in API) | worker (separate process) | off
JOBS_MODE=inline
# Cron expression (default every 5 minutes)
JOBS_CRON="*/5 * * * *"
JOBS_TZ=Asia/Kolkata
LOW_BALANCE_THRESHOLD=10000

# AI (Phase C+: set AI_PROVIDER=gemini and AI_API_KEY)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_ENABLED=true
AI_JOBS=inline
